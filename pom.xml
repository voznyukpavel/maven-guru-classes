<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.splachgenerator</groupId>
    <artifactId>helloworld</artifactId>
    <version>1.3</version>

    <properties>
        <java.version>22</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.3.2</junit.version>
        <project.scm.id>github</project.scm.id>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

 <scm>
     <developerConnection>scm:git:https://github.com/voznyukpavel/maven-guru-classes.git</developerConnection>
     <url>https://github.com/voznyukpavel/maven-guru-classes</url>
     <tag>helloworld-1.3</tag>
  </scm>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.0</version>
            </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>2.5.3</version>
                    <configuration>
                        <scmCommentPrefix>[maven-release-plugin] [skip ci]</scmCommentPrefix>
                    </configuration>
                </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>repsy-release</id>
            <url>https://repo.repsy.io/user99044342/repsy-guru-release</url>
        </repository>
         <snapshotRepository>
            <id>repsy-snapshots</id>
            <url>https://repo.repsy.io/user99044342/repsy-guru-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>


</project>